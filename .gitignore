node_modules/
dist/
*.log

# Android build output — keep the project, not the build
apps/mobile/android/app/build/
apps/mobile/android/build/
apps/mobile/android/.gradle/
apps/mobile/android/local.properties
*.apk
*.aab

# never commit a real bearer token or JWT
.env
.env.local
.bearer-token*
**/.bearer-token*
.gateway-token*
**/.gateway-token*
.aider*
.claude/

# per-machine settings (real hostnames, etc.) - see local-config.ps1.example
apps/proxy/scripts/local-config.ps1

# Play Store category scrape: personal device data (installed app inventory,
# queue/checkpoint state), not the script itself. The useful output
# (apps/mobile/src/data/playCategories.json) IS committed - just not the
# per-device inputs/scratch state that produced it.
scripts/play-category-scrape/*.txt
scripts/play-category-scrape/queue.json
scripts/play-category-scrape/done.json
scripts/play-category-scrape/scrape.log
.superpowers/
.venv/
